{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    // Workers lack browser DOM APIs; runtime and Env types are generated by wrangler types.
    "lib": ["esnext"],
    "types": ["@cloudflare/vitest-plugin/types"]
  },
  "include": [
    "vitest.workerd.config.ts",
    "src/cloudflare",
    "src/**/*.workerd.test.ts",
    "probes/cloudflare/worker.ts",
    "probes/cloudflare/shared-worker.ts"
  ]
}
