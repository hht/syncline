{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Ephemeral Worker for probing platform limits: deployed with an ephemeral name (--name) by shared-write.ts and deleted when finished; omits name to prevent direct deployment.
  "main": "shared-worker.ts",
  "compatibility_date": "2026-09-30",
  "durable_objects": {
    "bindings": [{ "name": "SHARED", "class_name": "ProbeShared" }, { "name": "BROADCAST", "class_name": "ProbeBroadcast" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProbeShared", "ProbeBroadcast"] }]
}
