{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Ephemeral Worker for probing platform limits: deployed with an ephemeral name (--name) by push-size.ts and deleted when finished; omits name to prevent direct deployment.
  "main": "worker.ts",
  "compatibility_date": "2026-09-30",
  "durable_objects": { "bindings": [{ "name": "SPACE", "class_name": "ProbeSpace" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProbeSpace"] }]
}
