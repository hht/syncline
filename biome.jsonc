{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 140 },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "linter": {
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": "error",
        "noExcessiveLinesPerFunction": "error"
      },
      "style": {
        "noExcessiveLinesPerFile": "error"
      },
      "suspicious": {
        "noEmptyBlockStatements": "error",
        "noExplicitAny": "error"
      }
    }
  },
  "overrides": [
    // Code bundled into mobile apps must avoid built-ins unsupported by Hermes; tests run only in Node.
    { "includes": ["src/**", "!**/*.test.ts"], "plugins": ["./tools/check/hermes-builtins.grit"] }
  ]
}
