{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    // Scripts run directly from dependencies are JavaScript (Node does not strip TypeScript types there), with type checking enabled.
    "allowJs": true,
    "checkJs": true,
    "types": ["node"]
  },
  "include": [
    "*.ts",
    "tools/**/*.ts",
    "src",
    "probes/cloudflare/push-size.ts",
    "probes/cloudflare/kill.ts",
    "probes/cloudflare/cascade.ts",
    "probes/cloudflare/shared-write.ts"
  ],
  "exclude": ["vitest.workerd.config.ts", "src/cloudflare", "src/**/*.workerd.test.ts"]
}
