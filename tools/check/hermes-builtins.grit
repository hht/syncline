// Hermes on devices (shipped with React Native) lacks these two built-in methods, throwing "undefined is not a function" when called;
// Node and browsers include them, so tests pass while breaking on device. Hermes supports the rest of ES2023 (toReversed, with, findLast), so typecheck lib cannot catch these; this rule enforces it.
// @see https://github.com/vitalyiegorov/suuudokuuu/pull/446
language js

or {
  `$array.toSorted($...)`,
  `Array.fromAsync($...)`
} as $call where {
  register_diagnostic(span=$call, message="Hermes on devices lacks Array.prototype.toSorted and Array.fromAsync (throws at runtime): copy and sort with [...items].sort(...), or await items sequentially")
}
