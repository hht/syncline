{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Worker for platform tests in workerd, not deployed; uses compatibility date required by Cloudflare.
  "name": "syncline-test",
  "main": "test-worker.ts",
  "compatibility_date": "2026-09-30",
  "durable_objects": {
    "bindings": [
      { "name": "SPACE", "class_name": "TestSpace" },
      { "name": "CABINET", "class_name": "TestCabinet" },
      { "name": "CABINET_BROADCAST", "class_name": "TestCabinetBroadcast" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TestSpace"] },
    { "tag": "v2", "new_sqlite_classes": ["TestCabinet", "TestCabinetBroadcast"] }
  ],
  // The shared space entry point is uncached; pulls pass through cached TestCabinetEntry (Workers Cache).
  "cache": { "enabled": true },
  "exports": {
    "default": { "type": "worker", "cache": { "enabled": false } },
    "TestCabinetEntry": { "type": "worker", "cache": { "enabled": true } }
  }
}
