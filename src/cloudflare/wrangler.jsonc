{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // 平台测试用的 Worker（workerd 测试配置），不部署；兼容日期取接入方部署用的（不早于平台要求的那一天）
  "name": "syncline-test",
  "main": "test-worker.ts",
  "compatibility_date": "2026-09-30",
  "durable_objects": {
    "bindings": [
      { "name": "SPACE", "class_name": "TestSpace" },
      { "name": "CATALOG", "class_name": "TestCatalog" },
      { "name": "CATALOG_BROADCAST", "class_name": "TestCatalogBroadcast" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TestSpace"] },
    { "tag": "v2", "new_sqlite_classes": ["TestCatalog", "TestCatalogBroadcast"] }
  ],
  // 共用空间的入口不缓存，拉取经开了缓存的 TestCatalogEntry（Workers Cache）
  "cache": { "enabled": true, "cross_version_cache": true },
  "exports": {
    "default": { "type": "worker", "cache": { "enabled": false } },
    "TestCatalogEntry": { "type": "worker", "cache": { "enabled": true } }
  }
}
