{
  "name": "syncline",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "postinstall": "wrangler types --config src/cloudflare/wrangler.jsonc src/cloudflare/worker-configuration.d.ts",
