{
  "name": "syncline",
  "version": "0.0.0",
  "description": "Offline-first SQLite sync for Expo apps, backed by Cloudflare",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hht/syncline.git"
  },
  "bugs": "https://github.com/hht/syncline/issues",
  "homepage": "https://github.com/hht/syncline#readme",
  "keywords": [
    "sync",
    "offline-first",
    "local-first",
    "sqlite",
    "expo",
    "react-native",
    "cloudflare",
    "durable-objects",
    "drizzle"
  ],
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "postinstall": "wrangler types --config src/cloudflare/wrangler.jsonc src/cloudflare/worker-configuration.d.ts",
    "check": "node tools/check/check.ts",
    "q": "node tools/check/quiet.ts",
    "model": "node tools/dev/model.ts check",
    "model:setup": "node tools/dev/model.ts setup",
    "model:big": "node tools/dev/model.ts big",
    "model:trace": "node tools/dev/model.ts trace",
    "release": "node tools/release.ts"
  },
  "files": [
    "src",
    "!src/test",
    "!src/**/*.test.ts",
    "!src/**/test-*.ts",
    "!src/build-wasm.mjs",
    "!src/cloudflare/wrangler.jsonc",
    "ios",
    "android/build.gradle",
    "android/src",
    "metro.cjs",
    "expo-module.config.json",
    "README.zh-CN.md",
    "docs/reference"
  ],
  "exports": {
    "./expo": {
      "browser": "./src/expo/web.ts",
      "default": "./src/expo/native.ts"
    },
    "./metro": "./metro.cjs",
    "./react": "./src/expo/react.ts",
    "./cloudflare": "./src/cloudflare/index.ts",
    "./expo/background": "./src/expo/background.ts"
  },
  "dependencies": {
    "drizzle-orm": "1.0.0-rc.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@cloudflare/vitest-plugin": "1.6.0",
    "@sqlite.org/sqlite-wasm": "3.53.4-build2",
    "@tanstack/react-query": "5.104.0",
    "@types/node": "^26.6.3",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitest/coverage-istanbul": "4.1.12",
    "dependency-cruiser": "18.4.0",
    "expo": "~58.0.23",
    "expo-background-task": "~58.0.11",
    "expo-task-manager": "~58.0.12",
    "fast-check": "4.10.2",
    "happy-dom": "21.0.4",
    "jscpd": "5.3.2",
    "knip": "6.38.0",
    "lefthook": "2.1.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "~6.0.3",
    "vitest": "4.1.12",
    "wrangler": "4.158.0",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@tanstack/react-query": "5.104.0",
    "expo": "~58.0.14",
    "react": "19.3.0",
    "expo-background-task": "~58.0.11",
    "expo-task-manager": "~58.0.12"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "expo-background-task": {
      "optional": true
    },
    "expo-task-manager": {
      "optional": true
    }
  }
}
