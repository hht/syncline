    "model": "node tools/dev/model.ts check",
    "model:setup": "node tools/dev/model.ts setup",
    "model:big": "node tools/dev/model.ts big",
    "model:trace": "node tools/dev/model.ts trace"
  },
  "exports": {
    "./expo": {
      "browser": "./src/expo/web.ts",
      "default": "./src/expo/native.ts"
    },
    "./metro": "./metro.cjs",
    "./react": "./src/expo/react.ts",
    "./cloudflare": "./src/cloudflare/index.ts",
    "./expo/background": "./src/expo/background.ts"
  },
  "dependencies": {
    "drizzle-orm": "1.0.0-rc.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@cloudflare/vitest-plugin": "1.3.4",
    "@sqlite.org/sqlite-wasm": "3.53.4-build2",
    "@tanstack/react-query": "5.104.0",
    "@types/node": "^26.6.3",
    "@types/react": "~19.3.0",
    "@vitest/coverage-istanbul": "4.1.11",
    "dependency-cruiser": "18.4.0",
    "expo": "~58.0.14",
    "expo-background-task": "~58.0.11",
    "expo-task-manager": "~58.0.12",
    "fast-check": "4.10.2",
    "jscpd": "5.3.2",
    "knip": "6.38.0",
    "lefthook": "2.1.14",
    "react": "19.3.0",
    "typescript": "~6.0.3",
    "vitest": "4.1.11",
    "wrangler": "4.145.0",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@tanstack/react-query": "5.104.0",
    "expo": "~58.0.14",
    "react": "19.3.0",
